    },
    {
      "group": "city_economy",
      "query": "\"economia carioca\"",
      "weight": 0.9,
      "why": "Sinal economico urbano sem restringir a turismo."
    },
    {
      "group": "city_core",
      "query": "\"Rio de Janeiro\" \"cidade\"",
      "weight": 0.8,
      "why": "Consulta ampla para fontes nacionais que nao usam sempre cidade do Rio."
    },
    {
      "group": "neighborhoods",
      "query": "\"Rio de Janeiro\" (\"Zona Sul\" OR \"Zona Norte\" OR \"Zona Oeste\" OR \"Centro do Rio\")",
      "weight": 0.75,
      "why": "Zonas urbanas para capturar noticias locais em volume."
    },
    {
      "group": "neighborhoods",
      "query": "\"Rio de Janeiro\" (Copacabana OR Ipanema OR Leblon OR Botafogo OR Tijuca OR Maracanã OR Maracana)",
      "weight": 0.75,
      "why": "Bairros e areas com alta producao noticiosa."
    },
    {
      "group": "transport_airports",
      "query": "\"Rio de Janeiro\" (Galeão OR Galeao OR \"Santos Dumont\" OR \"BRT Rio\" OR MetrôRio OR MetroRio)",
      "weight": 0.7,
      "why": "Infraestrutura urbana e portas de entrada da cidade."
    },
    {
      "group": "tourism_dimension",
      "query": "\"Rio de Janeiro\" (turismo OR turistas OR visitantes OR hotelaria OR eventos)",
      "weight": 0.65,
      "why": "Dimensao secundaria de turismo/eventos dentro do corpus amplo."
    },
    {
      "group": "tourism_dimension",
      "query": "\"cidade do Rio\" (turismo OR turistas OR hotelaria OR eventos OR \"ocupação hoteleira\")",
      "weight": 0.65,
      "why": "Recorte turistico sem virar portao principal de salvamento."
    },
    {
      "group": "local_sources",
      "query": "site:diariodorio.com \"Rio\"",
      "weight": 0.6,
      "why": "Fonte local com alto volume sobre a cidade."
    },
    {
      "group": "local_sources",
      "query": "site:riotur.rio OR site:prefeitura.rio",
      "weight": 0.55,
      "why": "Fontes municipais como reforco, nao universo exclusivo."
    }
  ]
